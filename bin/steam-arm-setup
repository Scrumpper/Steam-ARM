#!/bin/sh
# steam-arm-setup: wrapper for the native ARM64 Steam installer.
set -e

# read-only options need no root
for arg in "$@"; do
    case "$arg" in
        -h|--help)
            exec /usr/share/steam-arm-setup/install.sh --help
            ;;
    esac
done
case "$*" in
    --detect|--list)
        exec /usr/share/steam-arm-setup/install.sh "$1"
        ;;
esac
# no options in a terminal: settings menu, which asks for administrator rights itself
if [ "$#" -eq 0 ] && [ -t 0 ] && [ -t 1 ]; then
    exec /usr/share/steam-arm-setup/install.sh
fi

if [ "$(id -u)" -ne 0 ]; then
    echo "run as root: sudo steam-arm-setup" >&2
    exit 1
fi

exec /usr/share/steam-arm-setup/install.sh "$@"
